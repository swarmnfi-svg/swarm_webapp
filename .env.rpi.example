# Raspberry Pi primary — copy to .env.rpi and fill in values. Never commit .env.rpi.

# --- Public URLs (Cloudflare Tunnel or LAN) ---
# ESP firmware and Connect Device need a URL reachable from your site network.
SWARM_PUBLIC_API_URL=https://api.swarm.co.in/api
VITE_API_URL=https://api.swarm.co.in/api
SAAS_APP_URL=https://app.swarm.co.in
CORS_ORIGINS=https://app.swarm.co.in,https://api.swarm.co.in,capacitor://localhost,https://localhost

# --- Database (local MySQL container) ---
DB_NAME=biopower_db
DB_USER=biopower
DB_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password
# USB SSD mount on Pi (create directory first)
SWARM_MYSQL_DATA_DIR=/mnt/ssd/swarm/mysql

# --- Auth (must match Railway standby for JWT failover) ---
JWT_SECRET=your-shared-jwt-secret-min-256-bits

# --- Identity ---
IDENTITY_MODE=saas
SAAS_ACCOUNTS_URL=https://accounts.empowerapp.in
SAAS_CLIENT_ID=swarm_webapp

# --- Railway standby sync (for scripts/sync-to-railway.sh) ---
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
RAILWAY_MYSQL_HOST=
RAILWAY_MYSQL_PORT=3306
RAILWAY_MYSQL_USER=root
RAILWAY_MYSQL_PASSWORD=
RAILWAY_MYSQL_DATABASE=railway
SYNC_BACKUP_DIR=/mnt/ssd/swarm/backups

# --- Nova LLM (optional on Pi primary) ---
NOVA_SPACE_OP_ENABLED=true
NOVA_THINK_ENABLED=true
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
