# Nova Space OP — LLM provider keys (DO NOT COMMIT — copy to backend/.env locally)
# Railway: set these in backend service Variables (never commit real keys to Git).

NOVA_SPACE_OP_ENABLED=true
NOVA_THINK_ENABLED=true
NOVA_NARRATE_ENABLED=true

# Groq (primary chain — OpenAI-compatible)
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
NOVA_GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (failover chain)
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
NOVA_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Google Gemini (final failover — keys from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_API_KEY_2=
NOVA_GEMINI_MODEL=gemini-2.0-flash

# Legacy single-slot (optional fallback)
NOVA_LLM_BASE_URL=https://api.groq.com/openai/v1
NOVA_LLM_API_KEY=
NOVA_LLM_MODEL=llama-3.3-70b-versatile
